# Copy this file to .env and fill in the values. Never commit .env.

# --- Twilio WhatsApp (inactive: trial blocks free-form WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio trial: SIDs of templates made in Console > Content Template Builder
TWILIO_CONTENT_TEXT_SID=
TWILIO_CONTENT_BUTTONS_SID=

# telegram | meta | twilio | console  (console = in-app phone mock-up, no real messages)
NOTIFIER=telegram

# --- Meta WhatsApp Cloud API (active notifier) ---
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
# Any random string; must match what you type in Meta's webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Leave blank for the default Graph API version
META_GRAPH_VERSION=

# --- Telegram bot (free; NOTIFIER=telegram). Token from @BotFather ---
TELEGRAM_BOT_TOKEN=

# --- Demo staff phones (E.164 format, e.g. +919876543210) ---
# Kept here instead of campus.json so personal numbers never reach GitHub.
STAFF_PHONE_ELECTRICIAN=
STAFF_PHONE_PLUMBER=
STAFF_PHONE_HOUSEKEEPING=
STAFF_PHONE_ESTATE_MANAGER=

# --- LLM (needs a model that can read images) ---
# groq (free, primary) | gemini (free, fallback) | claude
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Leave blank to use the provider's default fast model
LLM_MODEL=

# --- URLs ---
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
