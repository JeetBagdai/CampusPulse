# Slim image for Render's free tier: same app, YOLO via ONNX Runtime (no PyTorch).
# The full PyTorch image is ./Dockerfile; tag v1-pytorch is the pre-ONNX version.
FROM node:22-slim AS web
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 CV_BACKEND=onnx ORT_THREADS=1
WORKDIR /app/backend
COPY backend/requirements-render.txt ./
RUN pip install -r requirements-render.txt
COPY backend/ ./
COPY --from=web /app/frontend/dist /app/frontend/dist
EXPOSE 10000
CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
